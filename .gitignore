### ── Python / Django (backend) ─────────────────────────────
__pycache__/
*.py[cod]
*$py.class

# Django local database & migrations state you don't want to ship
db.sqlite3
db.sqlite3-journal

# Django collected static/media (regenerated, not source)
staticfiles/
media/

# Environment / secrets (SECRET_KEY, API keys, DB creds, etc.)
.env
.env.*
!.env.example

# Virtual environments
venv/
.venv/
env/
ENV/

# Django local settings override, if you ever add one
local_settings.py


### ── Node / Vite / React (frontend) ────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite cache
.vite/


### ── Editor / IDE ──────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


### ── OS files ───────────────────────────────────────────────
.DS_Store
Thumbs.db